<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/tab_frame"
    android:orientation="vertical">

    <!-- 탭 줄: 크롬식 문서 탭(최대 6개) + 새 탭, 오른쪽에 실행 취소·다시 실행·저장·⋮.
         바탕은 한 단계 어둡고, 고른 탭은 아래 문서 화면 쪽과 같은 색으로 이어진다 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingEnd="6dp">

        <com.dsviewer.app.ChromeTabBar
            android:id="@+id/docTabs"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:paddingStart="6dp"
            android:paddingTop="6dp"
            android:paddingEnd="4dp" />

        <ImageButton
            android:id="@+id/actionUndo"
            style="@style/TabBarAction"
            android:contentDescription="실행 취소"
            android:src="@drawable/ic_undo"
            android:tooltipText="실행 취소" />

        <ImageButton
            android:id="@+id/actionRedo"
            style="@style/TabBarAction"
            android:contentDescription="다시 실행"
            android:src="@drawable/ic_redo"
            android:tooltipText="다시 실행" />

        <ImageButton
            android:id="@+id/actionSave"
            style="@style/TabBarAction"
            android:contentDescription="저장"
            android:src="@drawable/ic_save"
            android:tooltipText="저장" />

        <ImageButton
            android:id="@+id/actionMore"
            style="@style/TabBarAction"
            android:contentDescription="더 보기"
            android:src="@drawable/ic_more"
            android:tooltipText="더 보기" />
    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <com.dsviewer.app.DocumentView
            android:id="@+id/docView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@color/doc_bg" />

        <ProgressBar
            android:id="@+id/progress"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:visibility="gone" />

        <TextView
            android:id="@+id/pageLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|center_horizontal"
            android:layout_marginBottom="12dp"
            android:background="@drawable/bg_pill"
            android:paddingHorizontal="14dp"
            android:paddingVertical="5dp"
            android:textColor="#FFFFFF"
            android:textSize="13sp"
            android:visibility="gone" />

        <!-- 올가미로 고른 부분 위에 뜨는 막대 (위치는 ViewerActivity에서) -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/selectionBar"
            style="?attr/materialCardViewElevatedStyle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:visibility="gone"
            app:cardCornerRadius="22dp"
            app:cardElevation="6dp">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="44dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="6dp">

                <TextView
                    android:id="@+id/selectionCount"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="10dp"
                    android:textAppearance="?attr/textAppearanceLabelLarge" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/selectionColor"
                    style="?attr/materialButtonTonalStyle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="4dp"
                    android:text="색"
                    app:icon="@drawable/ic_palette"
                    app:iconTint="@null" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/selectionCopy"
                    style="?attr/materialButtonTonalStyle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="4dp"
                    android:text="복사"
                    app:icon="@drawable/ic_copy" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/selectionDelete"
                    style="?attr/materialButtonTonalStyle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="삭제"
                    app:icon="@drawable/ic_delete" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
    </FrameLayout>

    <!-- 보정 펜을 고르면 나오는 도형 줄 (칩은 ViewerActivity.setupShapeBar에서 만든다) -->
    <HorizontalScrollView
        android:id="@+id/shapeBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?attr/colorSurfaceContainer"
        android:scrollbars="none"
        android:visibility="gone">

        <com.google.android.material.chip.ChipGroup
            android:id="@+id/shapeChips"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingHorizontal="12dp"
            android:paddingTop="6dp"
            app:chipSpacingHorizontal="6dp"
            app:selectionRequired="true"
            app:singleLine="true"
            app:singleSelection="true" />
    </HorizontalScrollView>

    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?attr/colorSurfaceContainer"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="56dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="8dp">

            <ImageButton
                android:id="@+id/toolPen"
                android:layout_width="48dp"
                android:layout_height="44dp"
                android:background="@drawable/bg_tool"
                android:contentDescription="펜"
                android:src="@drawable/ic_pen" />

            <!-- 보정 펜 (아이콘은 코드에서 ShapePenDrawable) -->
            <ImageButton
                android:id="@+id/toolShape"
                android:layout_width="48dp"
                android:layout_height="44dp"
                android:layout_marginStart="4dp"
                android:background="@drawable/bg_tool"
                android:contentDescription="보정 펜" />

            <ImageButton
                android:id="@+id/toolHighlighter"
                android:layout_width="48dp"
                android:layout_height="44dp"
                android:layout_marginStart="4dp"
                android:background="@drawable/bg_tool"
                android:contentDescription="형광펜"
                android:src="@drawable/ic_highlighter" />

            <ImageButton
                android:id="@+id/toolEraser"
                android:layout_width="48dp"
                android:layout_height="44dp"
                android:layout_marginStart="4dp"
                android:background="@drawable/bg_tool"
                android:contentDescription="지우개"
                android:src="@drawable/ic_eraser" />

            <ImageButton
                android:id="@+id/toolLasso"
                android:layout_width="48dp"
                android:layout_height="44dp"
                android:layout_marginStart="4dp"
                android:background="@drawable/bg_tool"
                android:contentDescription="선택"
                android:src="@drawable/ic_lasso" />

            <View
                android:layout_width="1dp"
                android:layout_height="28dp"
                android:layout_marginHorizontal="10dp"
                android:background="?attr/colorOutlineVariant" />

            <LinearLayout
                android:id="@+id/colorRow"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:gravity="center_vertical"
                android:orientation="horizontal" />

            <View
                android:id="@+id/colorSep"
                android:layout_width="1dp"
                android:layout_height="28dp"
                android:layout_marginHorizontal="10dp"
                android:background="?attr/colorOutlineVariant" />

            <!-- 선택 도구: 자유/네모 선택 방식과 붙여넣기 -->
            <LinearLayout
                android:id="@+id/lassoRow"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:visibility="gone">

                <com.google.android.material.button.MaterialButtonToggleGroup
                    android:id="@+id/lassoMode"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:selectionRequired="true"
                    app:singleSelection="true">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/lassoFree"
                        style="?attr/materialButtonOutlinedStyle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="자유 선택"
                        app:icon="@drawable/ic_lasso" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/lassoRectBtn"
                        style="?attr/materialButtonOutlinedStyle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="네모 선택"
                        app:icon="@drawable/ic_select_rect" />
                </com.google.android.material.button.MaterialButtonToggleGroup>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/pasteButton"
                    style="?attr/materialButtonTonalStyle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:text="붙여넣기"
                    android:visibility="gone"
                    app:icon="@drawable/ic_paste" />
            </LinearLayout>

            <!-- 굵기 칸 3개 (ViewerActivity.buildWidths) -->
            <LinearLayout
                android:id="@+id/widthRow"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:gravity="center_vertical"
                android:orientation="horizontal" />
        </LinearLayout>
    </HorizontalScrollView>
</LinearLayout>
