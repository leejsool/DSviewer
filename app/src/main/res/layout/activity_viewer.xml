<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/tab_frame"
    android:orientation="vertical">

    <!-- 탭 줄: 크롬식 문서 탭(최대 6개) + 새 탭, 오른쪽에 실행 취소·다시 실행·저장·⋮.
         바탕은 한 단계 어둡고, 고른 탭은 아래 문서 화면 쪽과 같은 색으로 이어진다 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingEnd="6dp">

        <com.dsviewer.app.ChromeTabBar
            android:id="@+id/docTabs"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:paddingStart="6dp"
            android:paddingTop="6dp"
            android:paddingEnd="4dp" />

        <ImageButton
            android:id="@+id/actionUndo"
            style="@style/TabBarAction"
            android:contentDescription="실행 취소"
            android:src="@drawable/ic_undo"
            android:tooltipText="실행 취소" />

        <ImageButton
            android:id="@+id/actionRedo"
            style="@style/TabBarAction"
            android:contentDescription="다시 실행"
            android:src="@drawable/ic_redo"
            android:tooltipText="다시 실행" />

        <ImageButton
            android:id="@+id/actionSave"
            style="@style/TabBarAction"
            android:contentDescription="저장"
            android:src="@drawable/ic_save"
            android:tooltipText="저장" />

        <ImageButton
            android:id="@+id/actionInsert"
            style="@style/TabBarAction"
            android:contentDescription="삽입"
            android:src="@drawable/ic_insert"
            android:tooltipText="삽입" />

        <ImageButton
            android:id="@+id/actionOverview"
            style="@style/TabBarAction"
            android:contentDescription="쪽 한눈에 보기"
            android:src="@drawable/ic_grid_view"
            android:tooltipText="쪽 한눈에 보기" />

        <ImageButton
            android:id="@+id/actionMore"
            style="@style/TabBarAction"
            android:contentDescription="더 보기"
            android:src="@drawable/ic_more"
            android:tooltipText="더 보기" />
    </LinearLayout>

    <!-- 문서 화면 줄. 툴바를 왼쪽·오른쪽에 붙이면 이 줄의 앞·뒤에 들어온다
         (위·아래는 바깥 세로 줄의 탭 줄 다음·맨 끝). ViewerActivity.dockToolbar -->
    <LinearLayout
        android:id="@+id/docRow"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal">

    <FrameLayout
        android:id="@+id/docFrame"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1">

        <com.dsviewer.app.DocumentView
            android:id="@+id/docView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@color/doc_bg" />

        <!-- 문서 위에서 바로 치는 글 상자 (InlineTextEditor). 빈 곳은 터치를 문서로 넘긴다 -->
        <com.dsviewer.app.TextEditHost
            android:id="@+id/textEditHost"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <ProgressBar
            android:id="@+id/progress"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:visibility="gone" />

        <!-- 문서 위에 겹쳐 뜨는 아래쪽 묶음: 쪽 번호, 보정 펜 도형 줄, 지우개·선택 옵션 줄.
             줄이 나타나도 문서 화면 크기는 그대로라 필기가 밀리지 않는다.
             빈 곳은 터치를 받지 않아 아래 문서로 그대로 전달된다 -->
        <LinearLayout
            android:id="@+id/bottomOverlay"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom"
            android:orientation="vertical">

            <TextView
                android:id="@+id/pageLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginBottom="12dp"
                android:background="@drawable/bg_pill"
                android:paddingHorizontal="14dp"
                android:paddingVertical="5dp"
                android:textColor="#FFFFFF"
                android:textSize="13sp"
                android:visibility="gone" />

            <!-- 보정 펜을 고르면 나오는 도형 줄 (칩은 ViewerActivity.setupShapeBar에서 만든다) -->
            <HorizontalScrollView
                android:id="@+id/shapeBar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="?attr/colorSurfaceContainer"
                android:scrollbars="none"
                android:visibility="gone">

                <com.google.android.material.chip.ChipGroup
                    android:id="@+id/shapeChips"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:paddingHorizontal="12dp"
                    android:paddingTop="6dp"
                    app:chipSpacingHorizontal="6dp"
                    app:selectionRequired="true"
                    app:singleLine="true"
                    app:singleSelection="true" />
            </HorizontalScrollView>

            <!-- 글 상자를 치는 동안 뜨는 서식 줄 (ViewerActivity.setupFormatBar) -->
            <HorizontalScrollView
                android:id="@+id/formatBar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="?attr/colorSurfaceContainer"
                android:scrollbars="none"
                android:visibility="gone">

                <LinearLayout
                    android:id="@+id/formatRow"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingHorizontal="8dp"
                    android:paddingVertical="4dp" />
            </HorizontalScrollView>

            <!-- 지우개·선택 도구를 누르면 올라오는 옵션 줄. 하나 고르면 사라진다 (ViewerActivity.showOptionBar) -->
            <HorizontalScrollView
                android:id="@+id/toolOptionBar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="?attr/colorSurfaceContainer"
                android:scrollbars="none"
                android:visibility="gone">

                <LinearLayout
                    android:id="@+id/toolOptions"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingHorizontal="8dp"
                    android:paddingTop="6dp"
                    android:paddingBottom="2dp" />
            </HorizontalScrollView>
        </LinearLayout>

        <!-- 툴바가 위에 있을 때 도형 줄·옵션 줄은 여기로 옮겨 온다 (툴바 가까이 뜨게) -->
        <LinearLayout
            android:id="@+id/topOverlay"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="top"
            android:orientation="vertical" />

        <!-- 올가미로 고른 부분 위에 뜨는 막대 (위치는 ViewerActivity에서) -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/selectionBar"
            style="?attr/materialCardViewElevatedStyle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:visibility="gone"
            app:cardCornerRadius="22dp"
            app:cardElevation="6dp">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="44dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="6dp">

                <TextView
                    android:id="@+id/selectionCount"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="10dp"
                    android:textAppearance="?attr/textAppearanceLabelLarge" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/selectionColor"
                    style="?attr/materialButtonTonalStyle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="4dp"
                    android:text="색"
                    app:icon="@drawable/ic_palette"
                    app:iconTint="@null" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/selectionCopy"
                    style="?attr/materialButtonTonalStyle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="4dp"
                    android:text="복사"
                    app:icon="@drawable/ic_copy" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/selectionDelete"
                    style="?attr/materialButtonTonalStyle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="삭제"
                    app:icon="@drawable/ic_delete" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- 쪽 한눈에 보기: 문서 화면을 덮는 쪽 미리보기 모음 (PageOverview) -->
        <LinearLayout
            android:id="@+id/overviewPanel"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@color/doc_bg"
            android:clickable="true"
            android:focusable="true"
            android:orientation="vertical"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:background="?attr/colorSurfaceContainer"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="16dp"
                android:paddingEnd="4dp">

                <TextView
                    android:id="@+id/overviewTitle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:singleLine="true"
                    android:text="쪽 한눈에 보기"
                    android:textAppearance="?attr/textAppearanceTitleMedium" />

                <com.google.android.material.button.MaterialButtonToggleGroup
                    android:id="@+id/overviewFilter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:selectionRequired="true"
                    app:singleSelection="true">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/overviewAll"
                        style="?attr/materialButtonOutlinedStyle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="전체" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/overviewInked"
                        style="?attr/materialButtonOutlinedStyle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="필기된 쪽" />
                </com.google.android.material.button.MaterialButtonToggleGroup>

                <ImageButton
                    android:id="@+id/overviewClose"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:layout_marginStart="4dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="닫기"
                    android:src="@drawable/ic_close" />
            </LinearLayout>

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1">

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/overviewGrid"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:clipToPadding="false"
                    android:padding="6dp"
                    android:scrollbars="vertical" />

                <TextView
                    android:id="@+id/overviewEmpty"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:gravity="center"
                    android:padding="32dp"
                    android:text="아직 필기한 쪽이 없습니다."
                    android:textAppearance="?attr/textAppearanceBodyMedium"
                    android:visibility="gone" />
            </FrameLayout>
        </LinearLayout>
    </FrameLayout>
    </LinearLayout>

    <!-- 툴바: 펜·색·굵기. 맨 앞 손잡이를 끌어 위·아래·왼쪽·오른쪽에 붙일 수 있다.
         세로로 세우면 가로 스크롤 대신 세로 스크롤(코드에서 만듦)에 toolContent를 옮겨 담는다 -->
    <LinearLayout
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?attr/colorSurfaceContainer"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/toolbarHandle"
            android:layout_width="28dp"
            android:layout_height="56dp"
            android:contentDescription="툴바 옮기기 (끌어서 위·아래·왼쪽·오른쪽에 붙이기)"
            android:scaleType="center"
            android:src="@drawable/ic_drag_handle"
            android:tooltipText="끌어서 툴바 옮기기" />

    <HorizontalScrollView
        android:id="@+id/toolScrollH"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:scrollbars="none">

        <LinearLayout
            android:id="@+id/toolContent"
            android:layout_width="wrap_content"
            android:layout_height="56dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="0dp"
            android:paddingEnd="8dp">

            <ImageButton
                android:id="@+id/toolPen"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="@drawable/bg_tool"
                android:contentDescription="펜"
                android:src="@drawable/ic_pen" />

            <!-- 보정 펜 (아이콘은 코드에서 ShapePenDrawable) -->
            <ImageButton
                android:id="@+id/toolShape"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_marginStart="2dp"
                android:background="@drawable/bg_tool"
                android:contentDescription="보정 펜" />

            <ImageButton
                android:id="@+id/toolHighlighter"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_marginStart="2dp"
                android:background="@drawable/bg_tool"
                android:contentDescription="형광펜"
                android:src="@drawable/ic_highlighter" />

            <ImageButton
                android:id="@+id/toolText"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_marginStart="2dp"
                android:background="@drawable/bg_tool"
                android:contentDescription="글 넣기"
                android:src="@drawable/ic_text" />

            <ImageButton
                android:id="@+id/toolEraser"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_marginStart="2dp"
                android:background="@drawable/bg_tool"
                android:contentDescription="지우개"
                android:src="@drawable/ic_eraser_stroke" />

            <ImageButton
                android:id="@+id/toolLasso"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_marginStart="2dp"
                android:background="@drawable/bg_tool"
                android:contentDescription="선택"
                android:src="@drawable/ic_lasso" />

            <ImageButton
                android:id="@+id/toolLaser"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_marginStart="2dp"
                android:background="@drawable/bg_tool"
                android:contentDescription="레이저 포인터"
                android:src="@drawable/ic_laser" />

            <View
                android:layout_width="1dp"
                android:layout_height="28dp"
                android:layout_marginHorizontal="10dp"
                android:background="?attr/colorOutlineVariant" />

            <LinearLayout
                android:id="@+id/colorRow"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:gravity="center_vertical"
                android:orientation="horizontal" />

            <View
                android:id="@+id/colorSep"
                android:layout_width="1dp"
                android:layout_height="28dp"
                android:layout_marginHorizontal="10dp"
                android:background="?attr/colorOutlineVariant" />

            <!-- 선택 도구: 붙여넣기 (자유/네모 선택은 위 옵션 줄에서) -->
            <LinearLayout
                android:id="@+id/lassoRow"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:visibility="gone">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/pasteButton"
                    style="?attr/materialButtonTonalStyle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="붙여넣기"
                    android:visibility="gone"
                    app:icon="@drawable/ic_paste" />
            </LinearLayout>

            <!-- 글 도구: 글자 크기 '가' 칸 4개 (ViewerActivity.buildTextSizes) -->
            <LinearLayout
                android:id="@+id/textSizeRow"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:visibility="gone" />

            <!-- 굵기 칸 3개 (ViewerActivity.buildWidths) -->
            <LinearLayout
                android:id="@+id/widthRow"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:gravity="center_vertical"
                android:orientation="horizontal" />
        </LinearLayout>
    </HorizontalScrollView>
    </LinearLayout>
</LinearLayout>
