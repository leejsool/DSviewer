<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/tab_frame"
    android:orientation="vertical">

    <!-- 탭 줄: 크롬식 문서 탭(최대 6개) + 새 탭, 오른쪽에 실행 취소·다시 실행·저장·⋮.
         바탕은 한 단계 어둡고, 고른 탭은 아래 문서 화면 쪽과 같은 색으로 이어진다.
         폭이 좁으면 탭 줄이 고른 탭 하나 자리는 먼저 갖고, 오른쪽 단추 줄은 옆으로 밀어 본다 (TabActionRow) -->
    <com.dsviewer.app.TabActionRow
        android:id="@+id/tabRow"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <com.dsviewer.app.ChromeTabBar
            android:id="@+id/docTabs"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:paddingStart="6dp"
            android:paddingTop="6dp"
            android:paddingEnd="4dp" />

        <com.dsviewer.app.EdgeArrowScrollView
            android:id="@+id/actionScroll"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:fadingEdgeLength="20dp"
            android:overScrollMode="never"
            android:requiresFadingEdge="horizontal"
            android:scrollbars="none">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingEnd="6dp">

        <ImageButton
            android:id="@+id/actionUndo"
            style="@style/TabBarAction"
            android:contentDescription="실행 취소"
            android:src="@drawable/ic_undo"
            android:tooltipText="실행 취소" />

        <ImageButton
            android:id="@+id/actionRedo"
            style="@style/TabBarAction"
            android:contentDescription="다시 실행"
            android:src="@drawable/ic_redo"
            android:tooltipText="다시 실행" />

        <ImageButton
            android:id="@+id/actionSave"
            style="@style/TabBarAction"
            android:contentDescription="저장"
            android:src="@drawable/ic_save"
            android:tooltipText="저장" />

        <ImageButton
            android:id="@+id/actionInsert"
            style="@style/TabBarAction"
            android:contentDescription="삽입"
            android:src="@drawable/ic_insert"
            android:tooltipText="삽입" />

        <ImageButton
            android:id="@+id/actionWrong"
            style="@style/TabBarAction"
            android:contentDescription="오답"
            android:src="@drawable/ic_wrong_note"
            android:tooltipText="오답 (담기 · 목록 · 복습 · 문제지 · 통계)" />

        <!-- 보기 ▾: 양쪽 보기 · 분할 보기 · 페이지 관리 · 쪽 한눈에 보기 · 읽기 모드 · 전체 화면을 한 메뉴로 (아래 단추들은 처음엔 숨겨 둔다. 옵션 ▸ 상단 툴바에서 다시 꺼낼 수 있다) -->
        <ImageButton
            android:id="@+id/actionView"
            style="@style/TabBarAction"
            android:contentDescription="보기"
            android:src="@drawable/ic_view_menu"
            android:tooltipText="보기 (양쪽 보기 · 분할 보기 · 페이지 관리 · 한눈에 보기 · 읽기 모드 · 전체 화면)" />

        <!-- 보기: 양쪽 보기 · 분할 보기 · 페이지 관리 · 쪽 한눈에 보기 · 읽기 모드 · 전체 화면 (켜진 것은 바탕에 동그라미) -->
        <ImageButton
            android:id="@+id/actionTwoPage"
            style="@style/TabBarAction"
            android:contentDescription="양쪽 보기"
            android:src="@drawable/ic_two_page"
            android:tooltipText="양쪽 보기 (가로 화면)" />

        <ImageButton
            android:id="@+id/actionSplit"
            style="@style/TabBarAction"
            android:contentDescription="분할 보기"
            android:src="@drawable/ic_split_view"
            android:tooltipText="분할 보기 (두 문서 나란히: 가로 화면은 좌우, 세로 화면은 위아래)" />

        <ImageButton
            android:id="@+id/actionPages"
            style="@style/TabBarAction"
            android:contentDescription="페이지 관리"
            android:src="@drawable/ic_page_panel"
            android:tooltipText="페이지 관리" />

        <ImageButton
            android:id="@+id/actionOverview"
            style="@style/TabBarAction"
            android:contentDescription="쪽 한눈에 보기"
            android:src="@drawable/ic_grid_view"
            android:tooltipText="쪽 한눈에 보기" />

        <ImageButton
            android:id="@+id/actionReadMode"
            style="@style/TabBarAction"
            android:contentDescription="읽기 모드"
            android:src="@drawable/ic_write_mode"
            android:tooltipText="읽기 모드 (필기하지 않고 넘겨 보기)" />

        <ImageButton
            android:id="@+id/actionFullscreen"
            style="@style/TabBarAction"
            android:contentDescription="전체 화면"
            android:src="@drawable/ic_fullscreen"
            android:tooltipText="전체 화면" />

        <ImageButton
            android:id="@+id/actionMore"
            style="@style/TabBarAction"
            android:contentDescription="더 보기"
            android:src="@drawable/ic_more"
            android:tooltipText="더 보기" />
        </LinearLayout>
        </com.dsviewer.app.EdgeArrowScrollView>
    </com.dsviewer.app.TabActionRow>

    <!-- 문서 화면 줄. 툴바를 왼쪽·오른쪽에 붙이면 이 줄의 앞·뒤에 들어온다
         (위·아래는 바깥 세로 줄의 탭 줄 다음·맨 끝). ViewerActivity.dockToolbar -->
    <LinearLayout
        android:id="@+id/docRow"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal">

    <!-- 페이지 관리 창: 문서 왼쪽에 붙는 쪽 미리보기 목록 (PagePanel이 속을 채운다, 너비도 코드에서) -->
    <LinearLayout
        android:id="@+id/pagePanel"
        android:layout_width="250dp"
        android:layout_height="match_parent"
        android:background="?attr/colorSurfaceContainerLow"
        android:elevation="1dp"
        android:visibility="gone" />

    <FrameLayout
        android:id="@+id/docFrame"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1">

        <!-- 문서 화면: 보통은 첫 칸 하나, 분할 보기를 켜면 가로 화면은 좌우·세로 화면은 위아래로 두 칸 (SplitLayout).
             칸마다 문서 화면 + 문서 위에서 바로 치는 글 상자 층(InlineTextEditor, 빈 곳은 터치를 문서로 넘긴다) + 고른 칸 표시줄 -->
        <com.dsviewer.app.SplitLayout
            android:id="@+id/splitHost"
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <com.dsviewer.app.PaneFrame
                android:id="@+id/paneA"
                android:layout_width="match_parent"
                android:layout_height="match_parent">

                <com.dsviewer.app.DocumentView
                    android:id="@+id/docView"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@color/doc_bg" />

                <com.dsviewer.app.TextEditHost
                    android:id="@+id/textEditHost"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent" />

                <View
                    android:id="@+id/focusBarA"
                    android:layout_width="match_parent"
                    android:layout_height="3dp"
                    android:background="@color/active_stroke"
                    android:visibility="gone" />
            </com.dsviewer.app.PaneFrame>

            <com.dsviewer.app.PaneFrame
                android:id="@+id/paneB"
                android:layout_width="match_parent"
                android:layout_height="match_parent">

                <com.dsviewer.app.DocumentView
                    android:id="@+id/docView2"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@color/doc_bg" />

                <com.dsviewer.app.TextEditHost
                    android:id="@+id/textEditHost2"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent" />

                <View
                    android:id="@+id/focusBarB"
                    android:layout_width="match_parent"
                    android:layout_height="3dp"
                    android:background="@color/active_stroke"
                    android:visibility="gone" />
            </com.dsviewer.app.PaneFrame>
        </com.dsviewer.app.SplitLayout>

        <ProgressBar
            android:id="@+id/progress"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:visibility="gone" />

        <!-- 문서 위에 겹쳐 뜨는 아래쪽 묶음: 쪽 번호, 보정 펜 도형 줄, 지우개·선택 옵션 줄.
             줄이 나타나도 문서 화면 크기는 그대로라 필기가 밀리지 않는다.
             빈 곳은 터치를 받지 않아 아래 문서로 그대로 전달된다 -->
        <LinearLayout
            android:id="@+id/bottomOverlay"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom"
            android:orientation="vertical">

            <TextView
                android:id="@+id/pageLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginBottom="12dp"
                android:background="@drawable/bg_pill"
                android:paddingHorizontal="14dp"
                android:paddingVertical="5dp"
                android:textColor="#FFFFFF"
                android:textSize="13sp"
                android:visibility="gone" />

            <!-- 보정 펜을 고르면 나오는 도형 줄 (칸은 ViewerActivity.buildShapeBar에서 만든다).
                 툴바가 왼쪽·오른쪽이면 shapeRow를 코드에서 만든 세로 줄로 옮긴다 (ViewerActivity.placeOverlays) -->
            <com.dsviewer.app.EdgeArrowScrollView
                android:id="@+id/shapeBar"
                android:fillViewport="true"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="?attr/colorSurfaceContainer"
                android:scrollbars="none"
                android:visibility="gone">

                <LinearLayout
                    android:id="@+id/shapeRow"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:orientation="horizontal"
                    android:paddingHorizontal="8dp"
                    android:paddingTop="6dp"
                    android:paddingBottom="2dp" />
            </com.dsviewer.app.EdgeArrowScrollView>

            <!-- 글 상자를 치는 동안 뜨는 서식 줄 (ViewerActivity.setupFormatBar).
                 툴바가 왼쪽·오른쪽이면 formatRow를 코드에서 만든 세로 줄로 옮긴다 (ViewerActivity.placeOverlays) -->
            <com.dsviewer.app.EdgeArrowScrollView
                android:id="@+id/formatBar"
                android:fillViewport="true"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="?attr/colorSurfaceContainer"
                android:scrollbars="none"
                android:visibility="gone">

                <LinearLayout
                    android:id="@+id/formatRow"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:orientation="horizontal"
                    android:paddingHorizontal="8dp"
                    android:paddingVertical="4dp" />
            </com.dsviewer.app.EdgeArrowScrollView>

            <!-- 지우개·테이프 도구를 누르면 올라오는 옵션 줄. 하나 고르면 사라진다 (ViewerActivity.showOptionBar).
                 툴바가 왼쪽·오른쪽이면 toolOptions를 코드에서 만든 세로 줄로 옮긴다 -->
            <com.dsviewer.app.EdgeArrowScrollView
                android:id="@+id/toolOptionBar"
                android:fillViewport="true"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="?attr/colorSurfaceContainer"
                android:scrollbars="none"
                android:visibility="gone">

                <LinearLayout
                    android:id="@+id/toolOptions"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:orientation="horizontal"
                    android:paddingHorizontal="8dp"
                    android:paddingTop="6dp"
                    android:paddingBottom="2dp" />
            </com.dsviewer.app.EdgeArrowScrollView>

            <!-- 오답 복습 중에만 보이는 줄: 정답 보기 · 채점 · 끝내기 (ReviewController가 칸을 만든다) -->
            <com.dsviewer.app.EdgeArrowScrollView
                android:id="@+id/reviewBar"
                android:fillViewport="true"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="?attr/colorSurfaceContainer"
                android:scrollbars="none"
                android:visibility="gone">

                <LinearLayout
                    android:id="@+id/reviewRow"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingHorizontal="10dp"
                    android:paddingVertical="6dp" />
            </com.dsviewer.app.EdgeArrowScrollView>
        </LinearLayout>

        <!-- 툴바가 위에 있을 때 도형 줄·옵션 줄은 여기로 옮겨 온다 (툴바 가까이 뜨게) -->
        <LinearLayout
            android:id="@+id/topOverlay"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="top"
            android:orientation="vertical" />

        <!-- 올가미로 고른 부분 위에 뜨는 막대 (위치는 ViewerActivity에서) -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/selectionBar"
            style="?attr/materialCardViewElevatedStyle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:visibility="gone"
            app:cardCornerRadius="22dp"
            app:cardElevation="6dp">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="44dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="6dp">

                <TextView
                    android:id="@+id/selectionCount"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="10dp"
                    android:textAppearance="?attr/textAppearanceLabelLarge" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/selectionColor"
                    style="?attr/materialButtonTonalStyle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="4dp"
                    android:text="색"
                    app:icon="@drawable/ic_palette"
                    app:iconTint="@null" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/selectionFlipH"
                    style="?attr/materialButtonTonalStyle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="4dp"
                    android:text="좌우"
                    app:icon="@drawable/ic_flip_h" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/selectionFlipV"
                    style="?attr/materialButtonTonalStyle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="4dp"
                    android:text="상하"
                    app:icon="@drawable/ic_flip_v" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/selectionSymmetry"
                    style="?attr/materialButtonTonalStyle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="4dp"
                    android:text="대칭"
                    app:icon="@drawable/ic_symmetry" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/selectionCopy"
                    style="?attr/materialButtonTonalStyle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="4dp"
                    android:text="복사"
                    app:icon="@drawable/ic_copy" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/selectionDelete"
                    style="?attr/materialButtonTonalStyle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="삭제"
                    app:icon="@drawable/ic_delete" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- 전체 화면일 때만 보이는 지금 시각 (상태 표시줄을 숨겨도 시간을 볼 수 있게. 기기의 12/24시간 설정을 따른다) -->
        <TextClock
            android:id="@+id/fullscreenClock"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="top|start"
            android:layout_margin="10dp"
            android:alpha="0.75"
            android:background="@drawable/bg_pill"
            android:format12Hour="h:mm"
            android:format24Hour="H:mm"
            android:paddingHorizontal="12dp"
            android:paddingVertical="5dp"
            android:textColor="#FFFFFF"
            android:textSize="15sp"
            android:textStyle="bold"
            android:visibility="gone" />

        <!-- 전체 화면일 때만 보이는 '전체 화면 끝내기' 단추 -->
        <ImageButton
            android:id="@+id/exitFullscreen"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_gravity="top|end"
            android:layout_margin="10dp"
            android:alpha="0.75"
            android:background="@drawable/bg_pill"
            android:contentDescription="전체 화면 끝내기"
            android:padding="9dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_fullscreen_exit"
            android:tint="#FFFFFF"
            android:tooltipText="전체 화면 끝내기"
            android:visibility="gone" />

        <!-- 쪽 한눈에 보기: 문서 화면을 덮는 쪽 미리보기 모음 (PagePanel이 속을 채운다) -->
        <LinearLayout
            android:id="@+id/overviewPanel"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@color/doc_bg"
            android:clickable="true"
            android:focusable="true"
            android:visibility="gone" />
    </FrameLayout>
    </LinearLayout>

    <!-- 툴바: 펜·색·굵기. 맨 앞 손잡이를 끌어 위·아래·왼쪽·오른쪽에 붙일 수 있다.
         세로로 세우면 가로 스크롤 대신 세로 스크롤(코드에서 만듦)에 toolContent를 옮겨 담는다 -->
    <LinearLayout
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?attr/colorSurfaceContainer"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/toolbarHandle"
            android:layout_width="28dp"
            android:layout_height="56dp"
            android:contentDescription="툴바 손잡이 (누르면 보일 도구 고르기, 끌어서 위·아래·왼쪽·오른쪽에 붙이기)"
            android:scaleType="center"
            android:src="@drawable/ic_drag_handle"
            android:tooltipText="누르면 보일 도구 고르기, 끌면 툴바 옮기기" />

    <com.dsviewer.app.EdgeArrowScrollView
        android:id="@+id/toolScrollH"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:scrollbars="none">

        <LinearLayout
            android:id="@+id/toolContent"
            android:layout_width="wrap_content"
            android:layout_height="56dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="0dp"
            android:paddingEnd="8dp">

            <ImageButton
                android:id="@+id/toolPen"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="@drawable/bg_tool"
                android:contentDescription="펜"
                android:src="@drawable/ic_pen" />

            <!-- 보정 펜 (아이콘은 코드에서 ShapePenDrawable) -->
            <ImageButton
                android:id="@+id/toolShape"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_marginStart="2dp"
                android:background="@drawable/bg_tool"
                android:contentDescription="보정 펜" />

            <ImageButton
                android:id="@+id/toolHighlighter"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_marginStart="2dp"
                android:background="@drawable/bg_tool"
                android:contentDescription="형광펜"
                android:src="@drawable/ic_highlighter" />

            <ImageButton
                android:id="@+id/toolFill"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_marginStart="2dp"
                android:background="@drawable/bg_tool"
                android:contentDescription="채우기"
                android:src="@drawable/ic_fill" />

            <ImageButton
                android:id="@+id/toolTape"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_marginStart="2dp"
                android:background="@drawable/bg_tool"
                android:contentDescription="테이프"
                android:src="@drawable/ic_tape" />

            <ImageButton
                android:id="@+id/toolText"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_marginStart="2dp"
                android:background="@drawable/bg_tool"
                android:contentDescription="글 넣기"
                android:src="@drawable/ic_text" />

            <ImageButton
                android:id="@+id/toolEraser"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_marginStart="2dp"
                android:background="@drawable/bg_tool"
                android:contentDescription="지우개"
                android:src="@drawable/ic_eraser_stroke" />

            <ImageButton
                android:id="@+id/toolLasso"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_marginStart="2dp"
                android:background="@drawable/bg_tool"
                android:contentDescription="선택"
                android:src="@drawable/ic_lasso" />

            <ImageButton
                android:id="@+id/toolLaser"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_marginStart="2dp"
                android:background="@drawable/bg_tool"
                android:contentDescription="레이저 포인터"
                android:src="@drawable/ic_laser" />

            <!-- 자: 도구가 아니라 켜고 끄는 겹침 (펜·형광펜으로 가장자리를 따라 긋는다). 눌러서 직선자·눈금자·각도기를 고른다 -->
            <ImageButton
                android:id="@+id/toolRuler"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_marginStart="2dp"
                android:background="@drawable/bg_tool"
                android:contentDescription="자"
                android:src="@drawable/ic_ruler" />

            <View
                android:layout_width="1dp"
                android:layout_height="28dp"
                android:layout_marginHorizontal="10dp"
                android:background="?attr/colorOutlineVariant" />

            <LinearLayout
                android:id="@+id/colorRow"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:gravity="center_vertical"
                android:orientation="horizontal" />

            <View
                android:id="@+id/colorSep"
                android:layout_width="1dp"
                android:layout_height="28dp"
                android:layout_marginHorizontal="10dp"
                android:background="?attr/colorOutlineVariant" />

            <!-- 선택 도구: 붙여넣기 (자유/네모 선택은 위 옵션 줄에서) -->
            <LinearLayout
                android:id="@+id/lassoRow"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:visibility="gone">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/pasteButton"
                    style="?attr/materialButtonTonalStyle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="붙여넣기"
                    android:visibility="gone"
                    app:icon="@drawable/ic_paste" />
            </LinearLayout>

            <!-- 굵기 칸 3개 (ViewerActivity.buildWidths) -->
            <LinearLayout
                android:id="@+id/widthRow"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:gravity="center_vertical"
                android:orientation="horizontal" />
        </LinearLayout>
    </com.dsviewer.app.EdgeArrowScrollView>
    </LinearLayout>
</LinearLayout>
