<?xml version="1.0" encoding="utf-8"?>
<!-- 빈 쪽 서식 고르기: 바탕(흰 바탕·모눈·줄·점 격자 등)은 미리보기 카드로, 방향(세로·가로)은 그림 단추로.
     새 노트 만들기 창(dialog_new_note)과 빈 쪽 넣기 창(dialog_insert_page)이 같이 쓴다 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="바탕"
        android:textAppearance="?attr/textAppearanceLabelLarge" />

    <!-- 바탕 미리보기 카드들 (PaperPicker가 채운다) -->
    <FrameLayout
        android:id="@+id/paperPickerHost"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp" />

    <TextView
        android:id="@+id/orientLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="방향"
        android:textAppearance="?attr/textAppearanceLabelLarge" />

    <com.google.android.material.button.MaterialButtonToggleGroup
        android:id="@+id/orientGroup"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        app:selectionRequired="true"
        app:singleSelection="true">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/orientPortrait"
            style="@style/PageFormatChoice"
            android:contentDescription="세로"
            android:tooltipText="세로"
            app:icon="@drawable/ic_orient_portrait" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/orientLandscape"
            style="@style/PageFormatChoice"
            android:contentDescription="가로"
            android:tooltipText="가로"
            app:icon="@drawable/ic_orient_landscape" />
    </com.google.android.material.button.MaterialButtonToggleGroup>
</LinearLayout>
