<resources>
    <!-- 기기의 다크 모드와 상관없이 늘 밝은 파스텔 톤 (전자칠판처럼 까만 테마인 기기에서도 같은 색) -->
    <style name="Theme.DSViewer" parent="Theme.Material3.Light.NoActionBar">
        <item name="colorPrimary">@color/brand</item>
        <item name="colorOnPrimary">#FFFFFF</item>
        <item name="colorPrimaryContainer">#D8E6FB</item>
        <item name="colorOnPrimaryContainer">#1B3557</item>
        <item name="colorSecondary">#6A6A8E</item>
        <item name="colorOnSecondary">#FFFFFF</item>
        <item name="colorSecondaryContainer">#E2DDF6</item>
        <item name="colorOnSecondaryContainer">#2E2A4A</item>
        <item name="colorTertiary">#8E5F6E</item>
        <item name="colorOnTertiary">#FFFFFF</item>
        <item name="colorTertiaryContainer">#FBDDE5</item>
        <item name="colorOnTertiaryContainer">#47232F</item>
        <item name="android:colorBackground">#F7F9FD</item>
        <item name="colorOnBackground">#1F2733</item>
        <item name="colorSurface">#F9FBFE</item>
        <item name="colorOnSurface">#1F2733</item>
        <item name="colorSurfaceVariant">#E3EAF4</item>
        <item name="colorOnSurfaceVariant">#3E4A5C</item>
        <item name="colorSurfaceContainerLowest">#FFFFFF</item>
        <item name="colorSurfaceContainerLow">#F3F6FC</item>
        <item name="colorSurfaceContainer">#EDF2FA</item>
        <item name="colorSurfaceContainerHigh">#E6EDF7</item>
        <item name="colorSurfaceContainerHighest">#DFE7F3</item>
        <item name="colorOutline">#8A94A6</item>
        <item name="colorOutlineVariant">#C9D3E2</item>
        <item name="colorControlNormal">#3E4A5C</item>
        <item name="android:forceDarkAllowed">false</item>
    </style>

    <!-- 뷰어 탭 줄 오른쪽의 아이콘 버튼 (아이콘 20dp, 누르는 칸은 36×44dp: 아이콘 사이는 촘촘하게, 세로는 넉넉하게 해서 손가락·전자칠판에서 옆 단추를 잘못 누르지 않게) -->
    <style name="TabBarAction">
        <item name="android:layout_width">36dp</item>
        <item name="android:layout_height">44dp</item>
        <item name="android:paddingHorizontal">8dp</item>
        <item name="android:paddingVertical">12dp</item>
        <item name="android:scaleType">fitCenter</item>
        <item name="android:background">?attr/selectableItemBackgroundBorderless</item>
    </style>

    <!-- 빈 쪽 서식(바탕·방향)을 고르는 그림 단추 (view_page_format) -->
    <style name="PageFormatChoice" parent="Widget.Material3.Button.OutlinedButton">
        <item name="android:layout_width">64dp</item>
        <item name="android:layout_height">60dp</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:paddingStart">0dp</item>
        <item name="android:paddingEnd">0dp</item>
        <item name="iconSize">34dp</item>
        <item name="iconPadding">0dp</item>
        <item name="iconGravity">textStart</item>
    </style>

    <!-- 대칭 막대: 폰에서 좌우폭을 아끼려고 작고 촘촘한 버튼 -->
    <style name="SymSmallButton.Tonal" parent="Widget.Material3.Button.TonalButton">
        <item name="android:minWidth">0dp</item>
        <item name="android:minHeight">0dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:paddingStart">6dp</item>
        <item name="android:paddingEnd">6dp</item>
        <item name="android:textSize">13sp</item>
    </style>
    <style name="SymSmallButton.Outlined" parent="Widget.Material3.Button.OutlinedButton">
        <item name="android:minWidth">0dp</item>
        <item name="android:minHeight">0dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:paddingStart">6dp</item>
        <item name="android:paddingEnd">6dp</item>
        <item name="android:textSize">13sp</item>
    </style>
    <style name="SymSmallButton.Text" parent="Widget.Material3.Button.TextButton">
        <item name="android:minWidth">0dp</item>
        <item name="android:minHeight">0dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:paddingStart">6dp</item>
        <item name="android:paddingEnd">6dp</item>
        <item name="android:textSize">13sp</item>
    </style>
    <style name="SymSmallButton.Filled" parent="Widget.Material3.Button">
        <item name="android:minWidth">0dp</item>
        <item name="android:minHeight">0dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:paddingStart">8dp</item>
        <item name="android:paddingEnd">8dp</item>
        <item name="android:textSize">13sp</item>
    </style>
    <style name="SymCaption">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textSize">11sp</item>
        <item name="android:textColor">?attr/colorOnSurfaceVariant</item>
    </style>
</resources>
