<?xml version="1.0" encoding="utf-8"?>
<!-- 툴바 도구·굵기 칸·옵션 줄 칸의 바탕: 고른 칸은 아래에 짧은 밑줄 (아이콘 색은 color/icon_tint가 함께 바꾼다) -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_selected="true">
        <layer-list>
            <item android:width="20dp" android:height="3dp" android:gravity="bottom|center_horizontal">
                <shape android:shape="rectangle">
                    <solid android:color="@color/active_stroke" />
                    <corners android:radius="1.5dp" />
                </shape>
            </item>
        </layer-list>
    </item>
    <item>
        <color android:color="@android:color/transparent" />
    </item>
</selector>
